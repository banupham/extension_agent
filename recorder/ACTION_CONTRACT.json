{
  "version": 1,
  "extensionVersion": "1.5.0",
  "actions": {
    "navigation": [
      "openUrl",
      "reload",
      "goBack",
      "goForward",
      "waitForUrl"
    ],
    "pointer": [
      "clickRecorded",
      "click",
      "clickSelector",
      "clickFirstMatch",
      "doubleClickSelector",
      "hoverSelector",
      "moveMouse",
      "dragAndDrop",
      "scroll",
      "scrollTo",
      "scrollBy"
    ],
    "keyboard": [
      "type",
      "replaceText",
      "clearInput",
      "pressKey",
      "keyCombo"
    ],
    "forms": [
      "focusSelector",
      "selectOption",
      "setChecked"
    ],
    "wait": [
      "wait",
      "waitForSelector",
      "waitForUrl"
    ],
    "inspection": [
      "getElementPosition",
      "getActiveTab",
      "getElementText",
      "getPageInfo",
      "listTabs",
      "getCapabilities"
    ],
    "lifecycle": [
      "detach"
    ]
  },
  "recorderVersion": "3.8.0",
  "recordingMetadata": {
    "timing": ["seq", "t", "recordedAtEpoch", "gapFromPreviousMs", "timing.recordedGapMs", "timing.kind"],
    "pointer": ["pointerGesture", "point", "fallback", "recorded.target"],
    "text": ["editTrace"],
    "scroll": ["scrollTrace"],
    "scenario": ["recordingMeta"]
  }
}
