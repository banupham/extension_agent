{
  "version": 1,
  "extensionVersion": "1.5.0",
  "actions": {
    "navigation": ["openUrl", "reload", "goBack", "goForward", "waitForUrl"],
    "pointer": ["clickRecorded", "click", "clickSelector", "clickFirstMatch", "doubleClickSelector", "hoverSelector", "moveMouse", "dragAndDrop", "scroll", "scrollTo", "scrollBy"],
    "keyboard": ["type", "replaceText", "clearInput", "pressKey", "keyCombo"],
    "forms": ["focusSelector", "selectOption", "setChecked"],
    "wait": ["wait", "waitForSelector", "waitForUrl"],
    "inspection": ["getElementPosition", "getActiveTab", "getElementText", "getPageInfo", "listTabs", "getCapabilities"],
    "lifecycle": ["detach"]
  },
  "recorderVersion": "4.0.0",
  "timingModel": "detailed-input-mouse-v3",
  "textReplayPolicy": {
    "default": "keyboard-operations when reconstructable",
    "fallback": "replaceText only for paste/drop/composition/replacement/undo-redo or otherwise uncertain edits",
    "operationKinds": ["type", "pressKey", "keyCombo"],
    "counts": ["backspaceCount", "deleteCount", "enterCount", "tabCount", "typedCharCount", "keyComboCount", "operationCount"]
  },
  "recordingMetadata": {
    "timing": ["seq", "t", "tEnd", "recordedAtEpoch", "gapFromPreviousMs", "timing.recordedGapMs", "timing.kind"],
    "pointer": [
      "pointerGesture",
      "mousePath.samples",
      "mousePath.metrics.durationMs",
      "mousePath.metrics.pathDistancePx",
      "mousePath.metrics.averageSpeedPxPerSec",
      "mousePath.metrics.peakSpeedPxPerSec",
      "point",
      "fallback",
      "recorded.target"
    ],
    "text": [
      "initialValue",
      "finalValue",
      "reconstruction.mode",
      "reconstruction.uncertainReasons",
      "editTrace.operations",
      "editTrace.changes",
      "editTrace.summary.backspaceCount",
      "editTrace.summary.deleteCount",
      "editTrace.summary.typedCharCount"
    ],
    "scroll": [
      "scrollTrace.startedAtMs",
      "scrollTrace.endedAtMs",
      "scrollTrace.durationMs",
      "scrollTrace.samples",
      "scrollTrace.wheelSamples",
      "scrollTrace.metrics.start",
      "scrollTrace.metrics.end",
      "scrollTrace.metrics.displacementX",
      "scrollTrace.metrics.displacementY",
      "scrollTrace.metrics.straightDistancePx",
      "scrollTrace.metrics.pathDistancePx",
      "scrollTrace.metrics.averageSpeedPxPerSec",
      "scrollTrace.metrics.peakSpeedPxPerSec",
      "scrollTrace.metrics.direction",
      "scrollTrace.metrics.sourceHint",
      "scrollTrace.metrics.wheelTotalDeltaX",
      "scrollTrace.metrics.wheelTotalDeltaY",
      "scrollTrace.metrics.speedSamples"
    ],
    "scenario": ["recordingMeta"]
  }
}
