{
  "manifest_version": 3,
  "name": "Browser Action Recorder V3.6 Deterministic",
  "version": "3.6.0",
  "description": "Tab-persistent semantic recorder with remembered export directory.",
  "permissions": ["storage", "downloads", "activeTab", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Browser Action Recorder V3"
  },
  "background": {"service_worker": "background.js"},
  "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": false}]
}
