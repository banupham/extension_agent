{
  "manifest_version": 3,
  "name": "Browser Action Recorder V3.8 Rich Timing",
  "version": "3.8.0",
  "description": "Deterministic recorder with exact waits plus rich click, text-edit and scroll traces for later variant generation.",
  "permissions": [
    "storage",
    "downloads",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Browser Action Recorder V3.8"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
