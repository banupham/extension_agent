{
  "manifest_version": 3,
  "name": "Training Collector V0.2 Architecture Foundation",
  "version": "0.2.0",
  "description": "Privacy-first semantic state and human action transition collector for agent training episodes.",
  "permissions": ["activeTab", "tabs", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "core/privacy.js",
        "core/action_normalizer.js",
        "observer/semantic_observer.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Training Collector V0.2"
  }
}
