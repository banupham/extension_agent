{
  "manifest_version": 3,
  "name": "Training Collector V0.5 Compact Raw",
  "version": "0.5.0",
  "description": "Privacy-first continuous physical and semantic DOM capture with compact target refs, mutation bursts, improved visibility and selector quality.",
  "permissions": ["activeTab", "tabs", "storage", "unlimitedStorage", "downloads"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "core/privacy.js",
        "core/action_normalizer.js",
        "core/state_diff.js",
        "observer/element_registry.js",
        "observer/semantic_observer.js",
        "correlation/physical_semantic_correlator.js",
        "capture/physical_capture.js",
        "capture/dom_capture.js",
        "observer/mutation_trace.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Training Collector V0.5"
  }
}
