{
  "manifest_version": 3,
  "name": "Training Collector V0.3 Raw Browser Session",
  "version": "0.3.0",
  "description": "Privacy-first continuous raw physical interaction capture across a Chrome browser session, plus optional semantic task episodes.",
  "permissions": ["activeTab", "tabs", "storage", "unlimitedStorage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "core/privacy.js",
        "core/action_normalizer.js",
        "observer/semantic_observer.js",
        "capture/physical_capture.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Training Collector V0.3"
  }
}
