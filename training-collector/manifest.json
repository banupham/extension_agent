{
  "manifest_version": 3,
  "name": "Training Collector V0.6.1 IndexedDB Auto Export",
  "version": "0.6.1",
  "description": "Privacy-first continuous physical and semantic DOM capture with IndexedDB chunks, ACK retry, integrity verification and temporary automatic JSONL.gz development export.",
  "permissions": ["activeTab", "tabs", "storage", "unlimitedStorage", "downloads", "offscreen", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "core/privacy.js",
        "core/action_normalizer.js",
        "core/state_diff.js",
        "core/reliable_sender.js",
        "observer/element_registry.js",
        "observer/semantic_observer.js",
        "correlation/physical_semantic_correlator.js",
        "capture/physical_capture.js",
        "capture/dom_capture.js",
        "observer/mutation_trace.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Training Collector V0.6.1"
  }
}
