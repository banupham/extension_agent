{
  "manifest_version": 3,
  "name": "Training Collector V0.7.2 Frame-Aware Stream Diagnostics",
  "version": "0.7.2",
  "description": "Privacy-first continuous physical and semantic capture with all-frame raw observation, SPA route snapshots, stream-health diagnostics, action semantics, IndexedDB persistence and temporary automatic JSONL.gz recovery/export.",
  "permissions": ["activeTab", "tabs", "storage", "unlimitedStorage", "downloads", "offscreen", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "js": [
        "core/privacy.js",
        "core/action_normalizer.js",
        "core/state_diff.js",
        "core/reliable_sender.js",
        "observer/element_registry.js",
        "observer/semantic_observer.js",
        "correlation/physical_semantic_correlator.js",
        "correlation/action_target_resolver.js",
        "capture/physical_capture.js",
        "capture/dom_capture.js",
        "observer/mutation_trace.js",
        "observer/hover_trace.js",
        "observer/route_trace.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Training Collector V0.7.2"
  }
}
